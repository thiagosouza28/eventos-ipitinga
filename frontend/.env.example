# Processo do frontend (producao)
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
NEXT_DEV_SERVER=false

# Endereco publico do frontend
NEXT_PUBLIC_APP_URL=https://eventos.ideartcloud.com.br

# O navegador usa a mesma origem do frontend. O Next encaminha /api ao backend,
# evitando bloqueios de CORS e mantendo o endereço interno fora do bundle.
NEXT_PUBLIC_API_URL=/api

# URL acessível pelo servidor Next para encaminhar API e uploads.
BACKEND_URL=https://api.eventos.ideartcloud.com.br

# Cliente HTTP
NEXT_PUBLIC_API_TIMEOUT_MS=20000
NEXT_PUBLIC_API_MAX_RETRIES=2
NEXT_PUBLIC_API_RETRY_DELAY_MS=400
NEXT_PUBLIC_SHOW_OFFLINE_BANNER=true
