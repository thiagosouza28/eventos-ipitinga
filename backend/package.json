{
  "name": "@eventos-ipitinga/backend",
  "version": "2.1.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "build": "npm run prisma:generate && node node_modules/typescript/bin/tsc -p tsconfig.json && node node_modules/tsc-alias/dist/bin/index.js -p tsconfig.json && npm run copy:templates",
    "start": "node server.js",
    "test": "node scripts/run-tests.mjs",
    "type-check": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "copy:templates": "node scripts/copy-pdf-templates.mjs",
    "prisma:generate": "node scripts/prisma-cli.mjs generate",
    "prisma:migrate": "node scripts/prisma-cli.mjs migrate deploy",
    "prisma:status": "node scripts/prisma-cli.mjs migrate status",
    "db:seed": "node prisma/seed.mjs",
    "deploy:check": "npm run type-check && npm run prisma:status",
    "deploy:cpanel": "npm run type-check && npm run build && npm run prisma:migrate && npm run prisma:status"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "^6.19.2",
    "@sparticuz/chromium": "149.0.0",
    "@supabase/supabase-js": "^2.93.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.4",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^2.12.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.0",
    "puppeteer-core": "25.1.0",
    "qrcode": "^1.5.4",
    "slugify": "^1.6.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.16.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.10",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.19.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "deepmerge-ts": "8.0.1"
  },
  "engines": { "node": ">=22.17.0" }
}
