NODE_ENV=production
PORT=3001
SERVER_RUNTIME=server
ALLOW_INSECURE_APP_URL=false
APP_URL=https://eventos.ideartcloud.com.br
PUBLIC_APP_URL=https://eventos.ideartcloud.com.br
API_URL=https://api.eventos.ideartcloud.com.br/api
CORS_ORIGINS=https://eventos.ideartcloud.com.br

# MariaDB local no cPanel via socket. Confirme o caminho com: mysql_config --socket
DATABASE_URL="mysql://idea1240_USUARIO:SENHA_URL_ENCODED@localhost/idea1240_BANCO?socket=/var/lib/mysql/mysql.sock&connect_timeout=10&pool_timeout=10"
DATABASE_POOL_LIMIT=20
DATABASE_POOL_TIMEOUT=10
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1

JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRES_IN=30d
PASSWORD_SALT_ROUNDS=10

# cPanel com disco persistente: local. Render/disco efêmero: supabase.
STORAGE_DRIVER=local
RECEIPT_STORAGE_DIR=tmp/receipts

# Preencha somente se usar STORAGE_DRIVER=supabase.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLIC_KEY=SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=uploads

# Preencha somente se usar STORAGE_DRIVER=s3.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

MP_ACCESS_TOKEN=YOUR_MP_ACCESS_TOKEN
MP_WEBHOOK_SECRET=YOUR_MP_WEBHOOK_SECRET
MP_WEBHOOK_PUBLIC_URL=https://api.eventos.ideartcloud.com.br/api/webhooks/mercadopago
MP_INTEGRATOR_ID=
MP_TRANSFER_URL=https://api.mercadopago.com/v1/transfers
MP_TRANSFER_TIMEOUT_MS=10000
MP_TRANSFER_MAX_RETRIES=1
MP_READ_MAX_RETRIES=1
MP_READ_RETRY_DELAY_MS=300
ALLOW_INSECURE_AUTO_RETURN=false

PDF_SIGN_SECRET=CHANGE_ME
HMAC_SECRET=CHANGE_ME
CRON_SECRET=CHANGE_ME
PLAYWRIGHT_EXECUTABLE_PATH=
CHROMIUM_EXECUTABLE_PATH=
RECEIPT_MAX_CONCURRENCY=2

MAX_CONCURRENT_REQUESTS=20
MAX_PENDING_REQUESTS=100
REQUEST_QUEUE_TIMEOUT_MS=15000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

ORDER_EXPIRATION_MINUTES=45
CRON_CANCEL_EXPIRED=*/5 * * * *

CACHE_TTL_MS=30000
CACHE_MAX_ENTRIES=500
SCHEMA_CACHE_TTL_MS=300000
PERMISSIONS_CACHE_TTL_MS=60000

SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=66000
SERVER_REQUEST_TIMEOUT_MS=120000
STATIC_CACHE_MAX_AGE_MS=3600000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
CHECKIN_CONFIRM_PASSWORD=CHANGE_ME

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@example.com
SMTP_PASS=app_password
EMAIL_FROM=admin@example.com

AUTO_MIGRATE=false
