{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend do sistema de inscrições CATRE Ipitinga com Express, Prisma e Mercado Pago.",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "prebuild": "node scripts/prebuild.js",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/post-build.js",
    "dev": "ts-node-dev --transpile-only --ignore-watch node_modules --require tsconfig-paths/register src/main.ts",
    "dev:win": "chcp 65001>nul && ts-node-dev --transpile-only --ignore-watch node_modules --require tsconfig-paths/register src/main.ts",
    "playwright:install": "playwright install chromium",
    "postinstall": "node scripts/postinstall.js --mode=prod",
    "postinstall:prod": "node scripts/postinstall.js --mode=prod",
    "postinstall:dev": "node scripts/postinstall.js --mode=dev",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:setup": "ts-node scripts/setup-sqlite.ts",
    "openapi": "ts-node scripts/generate-openapi.ts",
    "photos:migrate": "ts-node -r tsconfig-paths/register scripts/migrate-registration-photos.ts",
    "doctor": "node scripts/doctor.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.2.0",
    "multer": "^2.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.10",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.1",
    "playwright": "^1.48.0",
    "prisma": "^5.19.0",
    "qrcode": "^1.5.4",
    "semver": "^7.6.3",
    "slugify": "^1.6.6",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc/core": "^1.15.8",
    "@swc/jest": "^0.2.39",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^30.2.0",
    "pg-mem": "^3.0.5",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "glob": "^8.1.0",
    "rimraf": "^4.4.1",
    "superagent": "^9.0.2"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
